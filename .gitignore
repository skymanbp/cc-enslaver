# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.ce/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code local state ---
# Project-scoped runtime data that should NOT be checked in.
.claude/local/
.claude/cache/
.claude/settings.local.json
.claude/*.lock

# --- Other Claude Code plugins' project-local state ---
# cc-memory plugin keeps memory.db + recent activity here; it is per-clone
# state, not team-shareable like .claude/cc-enforcer/edicts.toml.
memory/

# --- Build / dist artifacts ---
build/
dist/
*.tgz

# --- Logs and temp files ---
*.log
*.tmp
.tmp/

# --- Agent instructions, not repository documentation (v0.38.2) ---
# CLAUDE.md is the project instruction file Claude Code loads from disk. It
# is written FOR an agent, not for a reader, and section 5 carries the
# maintainer's mail address and machine paths. Claude Code reads it from the
# working tree regardless of git, so untracking costs the local session
# nothing; a clone simply does not get one. The doc gates in
# tests/test_doc_sync.py treat it as absent even when it is on disk, so the
# suite behaves the same here and on CI.
CLAUDE.md
